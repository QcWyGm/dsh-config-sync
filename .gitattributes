# 配置同步仓库：行尾规范化
#
# 会话日志（session.v4.jsonl.zstd 等）是 append-only 的多帧 zstd 二进制流。
# 一旦被 git 按文本处理做 CRLF 转换，字节就被改写 → 帧边界错位 → DSH 读时直接判 corrupt。
# 所以整条会话/附件路径必须钉成二进制，不受 core.autocrlf 影响。
conversations/sessions/**/*.zstd binary
conversations/sessions/**/*.zstd -text
conversations/attachments/** binary
conversations/attachments/** -text

# session_projcache 是 JSON 缓存，跨平台需保持 LF 一致，标记为二进制跳过 CRLF 转换
conversations/session_projcache/*.json binary

# 工作区资料必须字节保真：模型/图片/压缩包等一律不转换、不做行尾规范化
workspace/** -text
workspace/** binary

# 其余 JSON/JS/PS1/MD 统一 LF
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.patch text eol=lf

# 二进制资产不转换
*.tgz binary
*.zstd binary
*.zip binary
*.7z binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
